<?xml version="1.0"?>
<!-- A small OWL ontology in RDF/XML, for the loader and durability tests. -->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/materials">
  <owl:Ontology rdf:about="http://example.org/materials"/>
  <owl:Class rdf:about="http://example.org/materials#Material">
    <rdfs:label>Material</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/materials#Metal">
    <rdfs:subClassOf rdf:resource="http://example.org/materials#Material"/>
    <rdfs:label>Metal</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/materials#Alloy">
    <rdfs:subClassOf rdf:resource="http://example.org/materials#Metal"/>
    <rdfs:label>Alloy</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/materials#Polymer">
    <rdfs:subClassOf rdf:resource="http://example.org/materials#Material"/>
    <rdfs:label>Polymer</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://example.org/materials#hasProperty">
    <rdfs:domain rdf:resource="http://example.org/materials#Material"/>
  </owl:ObjectProperty>
</rdf:RDF>
