#!/usr/bin/env python3
"""Download Pizza, generate LUBM(1), or fetch the Gene Ontology.

Usage: scripts/fetch-data pizza|lubm|lubm-ontology|go
"""

import re
import shutil
import subprocess
import sys
import zipfile
from pathlib import Path
from urllib.request import urlretrieve

ROOT = Path(__file__).resolve().parents[1]
DOWNLOADS = ROOT / "data" / "downloads"
PIZZA_URL = "https://raw.githubusercontent.com/owlcs/pizza-ontology/master/pizza.owl"
UBA_URL = "http://swat.cse.lehigh.edu/projects/lubm/uba1.7.zip"
# The ontology IRI the generated data and data/lubm/queries use.
UNIV_BENCH = "http://www.lehigh.edu/~zhp2/2004/0401/univ-bench.owl"
UNIV_BENCH_SOURCE = "http://swat.cse.lehigh.edu/onto/univ-bench.owl"


def fetch(url, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    print(f"get {url}")
    urlretrieve(url, dest)


def pizza():
    dest = DOWNLOADS / "pizza.owl"
    fetch(PIZZA_URL, dest)
    print(dest)


def lubm():
    archive = DOWNLOADS / "uba1.7.zip"
    fetch(UBA_URL, archive)
    unpacked = DOWNLOADS / "lubm" / "uba"
    if unpacked.exists():
        shutil.rmtree(unpacked)
    with zipfile.ZipFile(archive) as zipped:
        zipped.extractall(unpacked)
    classes = None
    for path in unpacked.rglob("Generator.class"):
        parts = path.relative_to(unpacked).parts
        if "edu" not in parts:
            continue
        classes = unpacked.joinpath(*parts[: parts.index("edu")])
        break
    if classes is None:
        raise SystemExit("UBA zip has no Generator.class")
    out = DOWNLOADS / "lubm"
    out.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        [
            "java",
            "-cp",
            str(classes),
            "edu.lehigh.swat.bench.uba.Generator",
            "-univ",
            "1",
            "-index",
            "0",
            "-seed",
            "0",
            "-onto",
            UNIV_BENCH,
        ],
        cwd=out,
        check=True,
    )
    # The generator joins user.dir and the file name with a backslash, so on
    # macOS and Linux it writes "lubm\\University0_0.owl" next to the directory.
    for stray in out.parent.glob(out.name + "\\*"):
        stray.replace(out / stray.name.split("\\", 1)[1])
    produced = out / "University0_0.owl"
    if not produced.exists():
        raise SystemExit(f"generator did not write {produced}")
    print(produced)


GO_URL = "https://purl.obolibrary.org/obo/go/go-basic.obo"
OBO = "http://purl.obolibrary.org/obo/"
RDFS = "http://www.w3.org/2000/01/rdf-schema#"


def go():
    """Gene Ontology (basic, acyclic) as N-Triples: rdfs:subClassOf for every
    is_a edge and rdfs:label for every name. Obsolete terms are dropped.
    Also writes go.terms.tsv (IRI, name) for the embedding script."""
    out = DOWNLOADS / "go"
    obo = out / "go-basic.obo"
    if not obo.exists():
        fetch(GO_URL, obo)
    iri = lambda go_id: "<" + OBO + go_id.replace(":", "_") + ">"
    terms = {}
    cur = None
    in_term = False
    for line in obo.read_text(encoding="utf-8").splitlines():
        if line.startswith("["):
            in_term = line == "[Term]"
            cur = None
            continue
        if not in_term or ": " not in line:
            continue
        key, _, value = line.partition(": ")
        if key == "id":
            cur = {"id": value, "name": "", "is_a": [], "obsolete": False}
            terms[value] = cur
        elif cur is None:
            continue
        elif key == "name":
            cur["name"] = value
        elif key == "is_a":
            cur["is_a"].append(value.split(" ! ")[0].strip())
        elif key == "is_obsolete" and value == "true":
            cur["obsolete"] = True
    live = {i: t for i, t in terms.items() if not t["obsolete"]}
    edges = 0
    with (out / "go.nt").open("w", encoding="utf-8") as nt, (out / "go.terms.tsv").open("w", encoding="utf-8") as tsv:
        for go_id, term in live.items():
            nt.write(f'{iri(go_id)} <{RDFS}label> "{term["name"].replace(chr(92), chr(92) * 2).replace(chr(34), chr(92) + chr(34))}" .\n')
            tsv.write(f"{iri(go_id)}\t{term['name']}\n")
            for parent in term["is_a"]:
                if parent in live:
                    nt.write(f"{iri(go_id)} <{RDFS}subClassOf> {iri(parent)} .\n")
                    edges += 1
    print(f"{len(live)} terms, {edges} is_a edges -> {out / 'go.nt'}")


def lubm_ontology():
    """The univ-bench ontology itself (class hierarchy), with its IRIs renamed to
    the ones the generated data uses, so the two load together."""
    dest = DOWNLOADS / "lubm" / "univ-bench.owl"
    fetch(UNIV_BENCH_SOURCE, dest)
    dest.write_text(dest.read_text(encoding="utf-8").replace(UNIV_BENCH_SOURCE, UNIV_BENCH), encoding="utf-8")
    print(dest)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("pizza", "lubm", "lubm-ontology", "go"):
        print("usage: scripts/fetch-data pizza|lubm|lubm-ontology|go", file=sys.stderr)
        return 2
    if sys.argv[1] == "pizza":
        pizza()
    elif sys.argv[1] == "go":
        go()
    elif sys.argv[1] == "lubm-ontology":
        lubm_ontology()
    else:
        lubm()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
