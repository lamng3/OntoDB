#!/usr/bin/env python3
"""Run the crash harness for N seeds. Usage: scripts/crashtest --seeds N"""

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main():
    seeds = "4"
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "--seeds":
        seeds = args[1]
    elif args:
        print("usage: scripts/crashtest --seeds N", file=sys.stderr)
        return 2
    env = os.environ.copy()
    home = str(Path.home())
    env["PATH"] = f"{home}/bin:/opt/homebrew/bin:{env.get('PATH', '')}"
    env["ONTODB_CRASH_SEEDS"] = seeds
    subprocess.run(["cmake", "--preset", "dev"], cwd=ROOT, env=env, check=True)
    subprocess.run(["cmake", "--build", "--preset", "dev"], cwd=ROOT, env=env, check=True)
    binary = ROOT / "build" / "dev" / "ontodb_test"
    return subprocess.run(
        [str(binary), "--gtest_filter=CrashHarness.*"], cwd=ROOT, env=env
    ).returncode


if __name__ == "__main__":
    raise SystemExit(main())
